// Drop the plugin shared library next to the zenohd binary and it will be
// auto-loaded based on the plugins.storage_manager config below.
// Releases: https://github.com/eclipse-zenoh/zenoh/releases
{
  mode: "router",

  // Clients (this repo's scripts/ and test/) are expected to connect in
  // client mode to tcp/127.0.0.1:7447.
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },

  plugins: {
    storage_manager: {
      volumes: {
        // In-memory volume. Values are kept only as long as this process
        // keeps running.
        memory: {},
      },
      storages: {
        zenohackput_demo: {
          key_expr: "zenohackput/**",
          volume: "memory",
        },
      },
    },
  },
}
